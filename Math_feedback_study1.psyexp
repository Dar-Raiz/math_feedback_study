        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="errormsg=''&amp;#10;if r3reversed:&amp;#10;    correctkey = key_list[2-correctword_list[WordIndex-1]]&amp;#10;else:&amp;#10;    correctkey = key_list[correctword_list[WordIndex-1]-1]&amp;#10;&amp;#10;if Test3response.keys == correctkey: &amp;#10;    r3responseiscorrect = True&amp;#10;    r3chosenword = correctword_list[WordIndex-1]&amp;#10;    respbox_color = 'green'&amp;#10;    fbkimagefile = 'checkmark.png'&amp;#10;    totalcorrect = totalcorrect + 1&amp;#10;elif Test3response.keys:&amp;#10;    r3responseiscorrect = False&amp;#10;    r3chosenword = 3 - correctword_list[WordIndex-1]&amp;#10;    fbkimagefile = 'X_mark.png'&amp;#10;    respbox_color = 'red'&amp;#10;else:&amp;#10;    #no response&amp;#10;    r3responseiscorrect = False&amp;#10;    r3chosenword = 'miss'&amp;#10;    fbkimagefile = 'poundkey.png'&amp;#10;    respbox_color = background_color&amp;#10;    respbox_y = targetword_offset&amp;#10;    errormsg = 'no response'&amp;#10;&amp;#10;if Test3response.keys == key_list[0]: #top word selected&amp;#10;    respbox_y = topword_offset&amp;#10;elif Test3response.keys == key_list[1]: #bottom word selected&amp;#10;    respbox_y = bottomword_offset&amp;#10;if Test3response.keys:&amp;#10;    selectboxtrial_color = selectbox_color&amp;#10;    showrespdur = study2dur - Test3response.rt&amp;#10;    confrating_dur = maxconffbkchoice_dur&amp;#10;    choosefbk_dur = maxconffbkchoice_dur&amp;#10;    slowresptrial_delay = slowrespmessage_delay&amp;#10;    slowresptrial_dur = slowrespmessage_dur&amp;#10;else:&amp;#10;    showrespdur = 0&amp;#10;    selectboxtrial_color = background_color&amp;#10;    confrating_dur = 0&amp;#10;    choosefbk_dur = 0&amp;#10;    slowresptrial_delay = 0&amp;#10;    slowresptrial_dur = 0&amp;#10;thisExp.addData('r3reversed',r3reversed)&amp;#10;thisExp.addData('r3responseiscorrect', r3responseiscorrect)&amp;#10;thisExp.addData('r3chosenword', r3chosenword)&amp;#10;" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
